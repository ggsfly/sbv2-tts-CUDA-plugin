{
  "manifest_version": 2,
  "version": "1.1.1",
  "name": "Style-Bert-VITS2 日文语音合成插件 (CUDA)",
  "description": "调用本地 Style-Bert-VITS2 (CUDA) 推理服务合成日文语音的 TTS 插件",
  "plugin_type": "media",
  "author": {
    "name": "ggsfly",
    "url": "https://github.com/ggsfly"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/ggsfly/sbv2-tts-cuda-plugin",
    "homepage": "https://github.com/ggsfly/sbv2-tts-cuda-plugin",
    "documentation": "https://github.com/ggsfly/sbv2-tts-cuda-plugin",
    "issues": "https://github.com/ggsfly/sbv2-tts-cuda-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    }
  ],
  "capabilities": [
    "send.custom",
    "send.text",
    "llm.generate",
    "llm.get_available_models",
    "component.disable"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "ggsfly.sbv2-tts-cuda-plugin"
}
